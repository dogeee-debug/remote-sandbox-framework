REMOTE_SANDBOX_PROVIDER=generic
REMOTE_SANDBOX_TOKEN=replace-with-a-long-random-token
REMOTE_SANDBOX_WORKSPACE=/path/to/your/workspace
REMOTE_SANDBOX_RUNTIME_ROOT=/path/to/remote-sandbox-framework/runtime
REMOTE_SANDBOX_HOST=0.0.0.0
REMOTE_SANDBOX_PORT=8787
REMOTE_SANDBOX_HOURLY_RATE=0
REMOTE_SANDBOX_AUTOSTART_LEASE=1
REMOTE_SANDBOX_IDLE_SHUTDOWN_SECONDS=300
REMOTE_SANDBOX_ENABLE_SHUTDOWN=0
REMOTE_SANDBOX_SHUTDOWN_COMMAND=shutdown -h now
REMOTE_SANDBOX_LOG_TAIL_LINES=200
REMOTE_SANDBOX_DEFAULT_TIMEOUT=0
